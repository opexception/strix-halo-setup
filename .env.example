# Per-machine file; copy with scripts/init-config.sh, do not commit
COMPOSE_PROJECT_NAME=haloai
PUBLIC_BIND_IP=127.0.0.1
EDGE_BIND_IP=0.0.0.0
OLLAMA_PORT=11434
API_PORT=4000
CHAT_PORT=3000

# Replace with vetted immutable digests after target-host validation
OLLAMA_IMAGE=ollama/ollama:rocm
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.106.2
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
POSTGRES_IMAGE=postgres:16-alpine
CADDY_IMAGE=caddy:2

# gfx1151: populated from host group database by init-config.sh
RENDER_GID=0
VIDEO_GID=0
OLLAMA_MODEL=llama3.2:3b
OLLAMA_PROVIDER_MODEL=ollama_chat/llama3.2:3b
LITELLM_MODEL_NAME=local-default
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=5m

# Replaced with unique random values by init-config.sh
LITELLM_MASTER_KEY=sk-REPLACE_ME
LITELLM_SALT_KEY=sk-REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
WEBUI_SECRET_KEY=REPLACE_ME
WEBUI_ADMIN_EMAIL=admin@halo.local
WEBUI_ADMIN_PASSWORD=REPLACE_ME
# Set using create-virtual-key.sh --for-webui after stage 2 starts
OPENWEBUI_API_KEY=REPLACE_WITH_VIRTUAL_KEY

# Stage 4: resolve names to host; configure TLS mode
API_DOMAIN=api.halo.example.invalid
CHAT_DOMAIN=chat.halo.example.invalid
# Public real-DNS certificates OR private internal CA
CADDYFILE_PATH=./config/caddy/Caddyfile.public
